# Copy to .env and fill in values. Never commit .env.

# Groq LLM (OpenAI-compatible)
# Get a key: https://console.groq.com/
GROQ_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Optional aliases (also supported)
# LLM_API_KEY=...
# GROQ_MODEL=llama-3.1-8b-instant

# Optional generation controls
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Recommendation pipeline
CANDIDATE_TOP_N=25
MAX_ADDITIONAL_PREFS_LEN=500

# Paths (relative to project root). SQLite is used because it is portable
# and avoids parquet engine issues on locked-down Windows hosts.
PROCESSED_DATA_PATH=data/processed/restaurants.sqlite

# CORS (Railway). Comma-separated origins, or * for demos.
# Example: https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=*
